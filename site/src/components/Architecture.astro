---
// The quick start as a picture: a SPIRE JWT-SVID exchanged for AWS
// credentials. The identity token provider fetches the SVID, the AWS
// provider exchanges it at STS and sends the credentials on its channel, and
// repeats before they expire. Steps match index.mdx.
---
<figure class="diagram">
  <div class="scroll">
    <svg viewBox="0 0 1080 430" role="img" aria-label="tokenex in a Go process, exchanging a SPIRE JWT-SVID for AWS credentials. 1: the SPIRE agent issues a JWT-SVID to the identity token provider. 2: the AWS credentials provider gets the token from it. 3: it exchanges the token at AWS STS. 4: STS checks it against the keys SPIRE publishes, which an IAM OIDC provider trusts. 5: the credentials arrive on the channel as an Update; before they expire, tokenex gets a new token and exchanges it again. 6: your code signs its AWS calls with them.">
      <defs>
        <marker id="ar-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="d-head"></path></marker>
        <marker id="ar-arr-dash" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="d-head-dash"></path></marker>
        <marker id="ar-arr-acc" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="d-head-acc"></path></marker>
      </defs>

      <!-- Zones -->
      <rect x="1" y="20" width="200" height="396" rx="14" class="d-zone"></rect>
      <text x="16" y="404" class="d-zone-label">SPIRE</text>
      <rect x="221" y="20" width="565" height="396" rx="14" class="d-zone"></rect>
      <text x="236" y="404" class="d-zone-label">YOUR GO PROCESS</text>
      <rect x="806" y="20" width="273" height="396" rx="14" class="d-zone"></rect>
      <text x="820" y="404" class="d-zone-label">AWS</text>

      <!-- Boxes -->
      <rect x="20" y="56" width="162" height="64" rx="10" class="d-box"></rect>
      <text x="101" y="83" class="d-title" text-anchor="middle">OIDC discovery</text>
      <text x="101" y="103" class="d-sub" text-anchor="middle">publishes the keys</text>

      <rect x="20" y="150" width="162" height="64" rx="10" class="d-box"></rect>
      <text x="101" y="177" class="d-title" text-anchor="middle">SPIRE agent</text>
      <text x="101" y="197" class="d-sub" text-anchor="middle">Workload API</text>

      <rect x="262" y="150" width="190" height="64" rx="10" class="d-box-tokenex"></rect>
      <text x="357" y="177" class="d-title" text-anchor="middle">IdentityTokenProvider</text>
      <text x="357" y="197" class="d-sub" text-anchor="middle">token/spiffe</text>

      <rect x="566" y="150" width="190" height="64" rx="10" class="d-box-tokenex"></rect>
      <text x="661" y="177" class="d-title" text-anchor="middle">CredentialsProvider</text>
      <text x="661" y="197" class="d-sub" text-anchor="middle">pkg/aws</text>

      <rect x="566" y="330" width="190" height="64" rx="10" class="d-box"></rect>
      <text x="661" y="357" class="d-title" text-anchor="middle">your code</text>
      <text x="661" y="377" class="d-sub" text-anchor="middle">for res := range creds</text>

      <rect x="844" y="56" width="210" height="64" rx="10" class="d-box"></rect>
      <text x="949" y="83" class="d-title" text-anchor="middle">IAM OIDC provider</text>
      <text x="949" y="103" class="d-sub" text-anchor="middle">trusts SPIRE's issuer</text>

      <rect x="844" y="150" width="210" height="64" rx="10" class="d-box"></rect>
      <text x="949" y="177" class="d-title" text-anchor="middle">AWS STS</text>
      <text x="949" y="197" class="d-sub" text-anchor="middle">AssumeRoleWithWebIdentity</text>

      <rect x="844" y="330" width="210" height="64" rx="10" class="d-box"></rect>
      <text x="949" y="357" class="d-title" text-anchor="middle">AWS APIs</text>
      <text x="949" y="377" class="d-sub" text-anchor="middle">S3 · DynamoDB · …</text>

      <!-- The issuer's keys reach AWS -->
      <line x1="182" y1="88" x2="842" y2="88" class="d-edge-dash" marker-end="url(#ar-arr-dash)"></line>
      <text x="512" y="80" class="d-mono" text-anchor="middle">the issuer's keys (JWKS)</text>

      <!-- 1: SPIRE agent → identity token provider -->
      <line x1="182" y1="182" x2="260" y2="182" class="d-edge" marker-end="url(#ar-arr)"></line>
      <circle cx="211" cy="166" r="8" class="d-badge"></circle>
      <text x="211" y="170" class="d-badge-num" text-anchor="middle">1</text>
      <text x="221" y="202" class="d-mono d-halo" text-anchor="middle">JWT-SVID</text>

      <!-- 2: identity token provider → credentials provider -->
      <line x1="452" y1="182" x2="564" y2="182" class="d-edge" marker-end="url(#ar-arr)"></line>
      <circle cx="476" cy="166" r="8" class="d-badge"></circle>
      <text x="476" y="170" class="d-badge-num" text-anchor="middle">2</text>
      <text x="488" y="170" class="d-label">GetToken</text>

      <!-- Before the credentials expire, back to 2 -->
      <path d="M611 214 V262 H357 V216" class="d-edge-dash" marker-end="url(#ar-arr-dash)"></path>
      <text x="484" y="280" class="d-mono" text-anchor="middle">before they expire, again</text>

      <!-- 3: credentials provider → STS -->
      <line x1="756" y1="182" x2="842" y2="182" class="d-edge" marker-end="url(#ar-arr)"></line>
      <circle cx="778" cy="166" r="8" class="d-badge"></circle>
      <text x="778" y="170" class="d-badge-num" text-anchor="middle">3</text>
      <text x="800" y="202" class="d-mono d-halo" text-anchor="middle">exchange</text>

      <!-- 4: STS checks the keys -->
      <line x1="949" y1="150" x2="949" y2="122" class="d-edge-dash" marker-end="url(#ar-arr-dash)"></line>
      <circle cx="972" cy="136" r="8" class="d-badge"></circle>
      <text x="972" y="140" class="d-badge-num" text-anchor="middle">4</text>
      <text x="984" y="140" class="d-label">checks</text>

      <!-- 5: the credentials on the channel -->
      <line x1="711" y1="214" x2="711" y2="328" class="d-edge-acc d-flow" marker-end="url(#ar-arr-acc)"></line>
      <circle cx="733" cy="262" r="8" class="d-badge"></circle>
      <text x="733" y="266" class="d-badge-num" text-anchor="middle">5</text>
      <text x="745" y="266" class="d-label-acc d-halo">Update</text>
      <text x="723" y="290" class="d-mono d-halo">&lt;-chan Result</text>

      <!-- 6: your code → AWS, signed with them -->
      <line x1="756" y1="362" x2="842" y2="362" class="d-edge-acc d-flow" marker-end="url(#ar-arr-acc)"></line>
      <circle cx="778" cy="346" r="8" class="d-badge"></circle>
      <text x="778" y="350" class="d-badge-num" text-anchor="middle">6</text>
      <text x="790" y="350" class="d-label-acc d-halo">SigV4</text>
    </svg>
  </div>
  <figcaption><slot /></figcaption>
</figure>
