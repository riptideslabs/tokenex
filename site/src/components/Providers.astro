---
// One group of providers as a grid of small cards, each linking to its page.
import { providers } from "../providers";

interface Props {
  group: keyof typeof providers;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { group } = Astro.props;
---

<ul class="tx-providers not-content">
  {
    providers[group].map(({ name, pkg, page, hash, text }) => (
      <li>
        <a href={`${base}/${page}/${hash ? `#${hash}` : ""}`}>{name}</a>
        <code class="pkg">{pkg}</code>
        <p>{text}</p>
      </li>
    ))
  }
</ul>

<style>
  .tx-providers {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
    margin-block: 1rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    transition: border-color 0.15s;
  }
  li:hover { border-color: var(--sl-color-gray-4); }

  /* The whole card is the link. */
  a {
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  a:focus-visible { outline: none; }
  li:has(a:focus-visible) { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }

  /* Plain text, not the boxed inline code of the prose around it. */
  .tx-providers .pkg {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-text-accent);
  }
  p {
    margin: 0.2rem 0 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
</style>
